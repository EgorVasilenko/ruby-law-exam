# Frontend environment variables (Vite exposes only VITE_* to the client).
# Copy this file to frontend/.env to override defaults.

# API base URL. Leave empty to use relative /api (dev goes through the Vite proxy).
VITE_API_BASE_URL=

# Max upload size in MB, for client-side pre-validation (default 10).
# The backend remains the source of truth and enforces this too.
VITE_MAX_UPLOAD_MB=10
