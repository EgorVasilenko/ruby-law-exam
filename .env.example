# Backend environment variables
# Copy this file to backend/.env — the only value you must add is OPENAI_API_KEY.
# All other settings already have working defaults.
# NEVER commit the .env file — it is in .gitignore

# OpenAI
OPENAI_API_KEY=

# Model name (env-specific). Default: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# Sampling temperature 0-2 (default 0 for deterministic structured output)
OPENAI_TEMPERATURE=0

# Max characters of contract text sent to the model (default 60000)
OPENAI_MAX_INPUT_CHARS=60000

# Optional system-prompt override. Leave EMPTY to use the default prompt
# committed in backend/src/services/prompts.ts (source of truth, reviewable).
# Only set this to A/B-test a prompt without a rebuild.
AI_SYSTEM_PROMPT=

# Azure OpenAI (not implemented — provider sits behind the DI seam `AnalyzeFn`;
# switching = a new analyze impl + one line in container.ts. See README.)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173

# Max upload size in MB (default 10)
MAX_UPLOAD_MB=10
